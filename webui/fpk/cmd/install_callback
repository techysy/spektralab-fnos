#!/bin/bash
# install_callback -- after install: make the payload executable and confirm
# the runtime.  fnpack handles cmd/ exec bits; files under app/ land with the
# archive's modes, so the host binary gets its +x here.
set -e
APP_NAME="${TRIM_APPNAME:-spektralab}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"

chmod +x "$APP_DIR/spektralab-host" 2>/dev/null || true

if ! command -v python3 > /dev/null 2>&1; then
  echo "python3 not found on the system" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi
if [ ! -f "$APP_DIR/spektralab-host" ]; then
  echo "engine host binary missing from the package" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi
exit 0
