#!/bin/bash
# install_callback -- after install/upgrade: make sure the compose's image
# reference (spektralab-fnos:webui, a stable local tag decoupled from app
# versions) resolves before the framework brings the project up.
#
# The fpk ships the image tar next to the compose file
# (app/docker/spektralab-fnos.tar.gz).  `docker load` restores whatever tag
# the tar carries (webui-<appver>); we retag it to the stable reference.
#
# Lifecycle scripts run as the package user (config/privilege
# run-as=package), which reaches the docker socket through
# join-groups: docker.
set -e
DOCKER="$(command -v docker || echo /usr/bin/docker)"
IMG_TAR="$TRIM_APPDEST/docker/spektralab-fnos.tar.gz"
IMG_REF="spektralab-fnos:webui"

image_present() {
  "$DOCKER" image inspect "$1" > /dev/null 2>&1
}

if image_present "$IMG_REF"; then
  echo "image $IMG_REF already present"
  exit 0
fi

if [ ! -f "$IMG_TAR" ]; then
  echo "$IMG_TAR missing and $IMG_REF not present" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi

echo "loading engine image from $IMG_TAR"
LOADED="$("$DOCKER" load -i "$IMG_TAR" 2>&1 | grep -oE 'spektralab-fnos:[^ ]+' | head -1 || true)"
if [ -z "$LOADED" ] || ! image_present "$LOADED"; then
  echo "docker load did not yield a usable image" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi
"$DOCKER" tag "$LOADED" "$IMG_REF"
echo "tagged $LOADED -> $IMG_REF"
exit 0
