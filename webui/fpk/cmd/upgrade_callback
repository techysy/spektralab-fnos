#!/bin/bash
# upgrade_callback -- after upgrade: reload the engine image for the new version.
set -e
IMG_TAR="$TRIM_APPDEST/docker/spektralab-fnos.tar.gz"
if [ -f "$IMG_TAR" ]; then
  docker load -i "$IMG_TAR" || echo "docker load failed (image may come from a registry)" > "$TRIM_TEMP_LOGFILE"
fi
exit 0
